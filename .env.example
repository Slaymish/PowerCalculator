# Copy to .env.local and fill in
# Base URL of your Home Assistant instance.
# If routed under the app's origin via Cloudflare Tunnel, set this to "/ha".
# Otherwise use the full HA URL, e.g. https://ha.example.com
VITE_HA_URL=/ha

# Long-lived access token from HA (Profile -> Security -> Long-Lived Access Tokens)
VITE_HA_TOKEN=

# Entity ID for the sensor tracking your server's cumulative energy (kWh)
# e.g. sensor.server_energy
VITE_SERVER_ENTITY_ID=sensor.server_energy
